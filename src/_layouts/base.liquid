<!DOCTYPE html>
{%- assign currentLang = "en" -%}
{%- assign pathParts = page.url | split: "/" -%}
{%- for part in pathParts -%}
  {%- if part == "de" or part == "fr" or part == "nl" or part == "it" or part == "es" -%}
    {%- assign currentLang = part -%}
  {%- endif -%}
{%- endfor -%}
{%- assign cleanUrl = page.url | replace: "/de/", "/" | replace: "/fr/", "/" | replace: "/nl/", "/" | replace: "/it/", "/" | replace: "/es/", "/" -%}
<html lang="{{ currentLang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Primary Meta Tags -->
  <title>{{ title }} | Barbuk - Legacy System Modernization</title>
  <meta name="title" content="{{ title }} | Barbuk - Legacy System Modernization">
  <meta name="description" content="{{ description | default: 'Transform your legacy systems into modern, high-performance applications. Expert B2B software modernization, AI integration, and workflow automation services.' }}">
  <meta name="keywords" content="legacy system modernization, enterprise software modernization, ASP.NET modernization, UI/UX redesign, workflow automation, AI integration, cloud migration, B2B software services">
  <meta name="author" content="Barbuk">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://barbuk.us{{ page.url }}">

  <!-- Hreflang: regional codes for SEO -->
  <link rel="alternate" hreflang="en-US" href="https://barbuk.us{{ cleanUrl }}">
  <link rel="alternate" hreflang="de-DE" href="https://barbuk.us/de{{ cleanUrl }}">
  <link rel="alternate" hreflang="fr-FR" href="https://barbuk.us/fr{{ cleanUrl }}">
  <link rel="alternate" hreflang="nl-NL" href="https://barbuk.us/nl{{ cleanUrl }}">
  <link rel="alternate" hreflang="it-IT" href="https://barbuk.us/it{{ cleanUrl }}">
  <link rel="alternate" hreflang="es-ES" href="https://barbuk.us/es{{ cleanUrl }}">
  <link rel="alternate" hreflang="x-default" href="https://barbuk.us{{ cleanUrl }}">

  <!-- Open Graph locale -->
  <meta property="og:locale" content="{{ i18n.meta[currentLang].hreflang | replace: '-', '_' }}">
  
  <!-- Open Graph / Facebook (per-locale image, secure_url, locale alternates) -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://barbuk.us{{ page.url }}">
  <meta property="og:title" content="{{ title }} | Barbuk - Legacy System Modernization">
  <meta property="og:description" content="{{ description | default: 'Transform your legacy systems into modern, high-performance applications. Expert B2B software modernization services.' }}">
  <meta property="og:image" content="https://barbuk.us/assets/images/og-image-{{ currentLang }}.png">
  <meta property="og:image:secure_url" content="https://barbuk.us/assets/images/og-image-{{ currentLang }}.png">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ title }} - Barbuk">
  <meta property="og:site_name" content="Barbuk">
  {%- for code in i18n.languages -%}
    {%- if code != currentLang -%}
  <meta property="og:locale:alternate" content="{{ i18n.meta[code].hreflang | replace: '-', '_' }}">
    {%- endif -%}
  {%- endfor -%}

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="https://barbuk.us{{ page.url }}">
  <meta property="twitter:title" content="{{ title }} | Barbuk - Legacy System Modernization">
  <meta property="twitter:description" content="{{ description | default: 'Transform your legacy systems into modern, high-performance applications.' }}">
  <meta property="twitter:image" content="https://barbuk.us/assets/images/og-image-{{ currentLang }}.png">
  <meta property="twitter:image:alt" content="{{ title }} - Barbuk">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/images/favicon.png">
  <link rel="apple-touch-icon" type="image/png" href="/assets/images/favicon.png">

  <!-- Preconnect + DNS-prefetch for performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="dns-prefetch" href="https://www.googletagmanager.com">
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/assets/css/style.css?v={{ buildTimestamp }}">
  
  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-LGM9Z7V71P"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-LGM9Z7V71P');
  </script>
  
  <!-- Structured Data (JSON-LD) — Organization + WebSite + BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Barbuk",
    "alternateName": "Barbuk.us",
    "url": "https://barbuk.us",
    "logo": "https://barbuk.us/assets/images/logo.png",
    "description": "Expert B2B software modernization services. Transform legacy systems into modern, high-performance applications with AI integration and workflow automation.",
    "foundingDate": "2026",
    "inLanguage": ["en-US", "de-DE", "fr-FR", "nl-NL", "it-IT", "es-ES"],
    "knowsLanguage": ["en-US", "de-DE", "fr-FR", "nl-NL", "it-IT", "es-ES"],
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "Customer Service",
      "email": "hello@barbuk.us",
      "availableLanguage": ["English", "German", "French", "Dutch", "Italian", "Spanish"]
    },
    "sameAs": [
      "https://github.com/barbuk-dev"
    ],
    "areaServed": [
      { "@type": "Country", "name": "United States" },
      { "@type": "Country", "name": "Germany" },
      { "@type": "Country", "name": "France" },
      { "@type": "Country", "name": "Netherlands" },
      { "@type": "Country", "name": "Italy" },
      { "@type": "Country", "name": "Spain" }
    ],
    "serviceType": [
      "Legacy System Modernization",
      "UI/UX Redesign",
      "Workflow Automation",
      "AI Integration",
      "Cloud Migration",
      "Performance Optimization"
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Barbuk",
    "alternateName": "Barbuk.us — Legacy System Modernization",
    "url": "https://barbuk.us",
    "inLanguage": "{{ i18n.meta[currentLang].hreflang }}"
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://barbuk.us{{ cleanUrl }}"
      }{% if page.url != "/" and page.url != "/index.html" %},
      {
        "@type": "ListItem",
        "position": 2,
        "name": "{{ title }}",
        "item": "https://barbuk.us{{ page.url }}"
      }{% endif %}
    ]
  }
  </script>
  {%- if page.url contains "/blog/" -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "Barbuk Insights",
    "url": "https://barbuk.us{{ page.url }}",
    "inLanguage": "{{ i18n.meta[currentLang].hreflang }}",
    "publisher": {
      "@type": "Organization",
      "name": "Barbuk",
      "logo": {
        "@type": "ImageObject",
        "url": "https://barbuk.us/assets/images/logo.png"
      }
    }
  }
  </script>
  {%- endif -%}
  <!-- RSS autodiscovery -->
  {%- assign rssLang = page.url | detectLang -%}
  {%- assign rssUrl = '/blog/rss.xml' -%}
  {%- if rssLang != 'en' -%}{%- assign rssUrl = '/' | append: rssLang | append: rssUrl -%}{%- endif -%}
  <link rel="alternate" type="application/rss+xml" title="{{ site_title }} - {{ i18n.nav.insights | default: 'Insights' }}" href="{{ rssUrl }}" />
</head>
<body>
  {% include "header.liquid" %}
  
  <main>
    {{ content }}
  </main>
  
  {% include "footer.liquid" %}

<script>
  // Localize <time data-localize="date"> elements via Intl.DateTimeFormat
  (function() {
    var locale = (document.documentElement.lang || 'en');
    if (locale === 'en') return; // EN already human-readable via ISO fallback
    var nodes = document.querySelectorAll('time[data-localize="date"]');
    if (!nodes.length) return;
    nodes.forEach(function(el) {
      var d = new Date(el.getAttribute('datetime'));
      if (isNaN(d.getTime())) return;
      el.textContent = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
    });
  })();
</script>
</body>
</html>
