---
permalink: /es/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Barbuk — Modernización de Sistemas Legacy</title>
  <subtitle>Artículos sobre modernización de sistemas legacy, integración de IA e ingeniería de software B2B.</subtitle>
  <link href="https://barbuk.us/es/feed.xml" rel="self"/>
  <link href="https://barbuk.us/es/"/>
  <id>https://barbuk.us/es/</id>
  <updated>{{ collections.blogPosts | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  {%- assign targetLang = "es" -%}
  {%- for post in collections.blogPosts -%}
    {%- assign postLang = "en" -%}
    {%- assign pathParts = post.url | split: "/" -%}
    {%- for part in pathParts -%}
      {%- if part == "de" or part == "fr" or part == "nl" or part == "it" or part == "es" -%}
        {%- assign postLang = part -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if postLang == targetLang -%}
      <entry>
        <title>{{ post.data.title }}</title>
        <link href="https://barbuk.us{{ post.url }}"/>
        <id>https://barbuk.us{{ post.url }}</id>
        <updated>{{ post.date | dateToRfc3339 }}</updated>
        <summary>{{ post.data.description }}</summary>
      </entry>
    {%- endif -%}
  {%- endfor %}
</feed>
