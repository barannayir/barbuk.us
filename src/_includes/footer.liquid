<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <h3>Barbuk</h3>
        <p>{{ i18n.footer.tagline | default: 'Modernizing legacy systems for forward-thinking businesses.' }}</p>
      </div>
      <div class="footer-col">
        <h4>{{ i18n.footer.services_heading | default: 'Services' }}</h4>
        <ul>
          <li><a href="{{ '/services' | localizedUrl: page.lang }}#modernization">{{ i18n.footer.services_modernization | default: 'Legacy Modernization' }}</a></li>
          <li><a href="{{ '/services' | localizedUrl: page.lang }}#ui-ux">{{ i18n.footer.services_uiux | default: 'UI/UX Redesign' }}</a></li>
          <li><a href="{{ '/services' | localizedUrl: page.lang }}#performance">{{ i18n.footer.services_performance | default: 'Performance Optimization' }}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{{ i18n.footer.company_heading | default: 'Company' }}</h4>
        <ul>
          <li><a href="{{ '/about' | localizedUrl: page.lang }}">{{ i18n.footer.company_about | default: 'About' }}</a></li>
          <li><a href="{{ '/portfolio' | localizedUrl: page.lang }}">{{ i18n.footer.company_portfolio | default: 'Portfolio' }}</a></li>
          <li><a href="{{ '/contact' | localizedUrl: page.lang }}">{{ i18n.footer.company_contact | default: 'Contact' }}</a></li>
          <li><a href="{{ '/privacy' | localizedUrl: page.lang }}">{{ i18n.footer.company_privacy | default: 'Privacy Policy' }}</a></li>
          <li><a href="{{ '/terms' | localizedUrl: page.lang }}">{{ i18n.footer.company_terms | default: 'Terms of Service' }}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{{ i18n.footer.connect_heading | default: 'Connect' }}</h4>
        <ul>
          <li><a href="mailto:hello@barbuk.us">hello@barbuk.us</a></li>
          <li><a href="https://github.com/barbuk-dev" target="_blank">{{ i18n.footer.connect_github | default: 'GitHub' }}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{{ i18n.footer.languages_heading | default: 'Languages' }}</h4>
        <div class="footer-languages">
          {%- assign currentLang = page.url | detectLang -%}
          {%- for code in i18n.languages -%}
            <a href="{{ '/contact' | urlByLang: code }}" data-lang="{{ code }}"{% if code == currentLang %} class="is-active"{% endif %} title="{{ i18n.meta[code].native }}" aria-label="{{ i18n.meta[code].native }}">
              <span class="flag" aria-hidden="true">{{ i18n.meta[code].flag }}</span>
            </a>
          {%- endfor -%}
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>{{ i18n.footer.copyright | default: '© 2026 Barbuk. All rights reserved.' }}</p>
    </div>
  </div>
</footer>
