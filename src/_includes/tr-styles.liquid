{%- comment -%}
  TR sayfalarına özel stil. Global style.css'te .why-modernize ve .faq-section kuralları yok
  (EN pillar sayfalarında da stilsiz görünüyor); diğer dilleri etkilememek için html[lang="tr"] ile sınırlı.
{%- endcomment -%}
<style>
html[lang="tr"] .why-modernize,
html[lang="tr"] .faq-section { padding: 5rem 0; }
html[lang="tr"] .why-modernize .container,
html[lang="tr"] .faq-section .container { max-width: 900px; }
html[lang="tr"] .why-modernize h2,
html[lang="tr"] .faq-section h2 { font-size: 2.25rem; font-weight: 800; margin-bottom: 1.25rem; text-align: center; }
html[lang="tr"] .why-modernize h3 { font-size: 1.25rem; margin: 2rem 0 1rem; }
html[lang="tr"] .why-modernize p { color: var(--text-secondary); line-height: 1.8; margin-bottom: 1.1rem; font-size: 1.05rem; }
html[lang="tr"] .why-modernize .section-intro { color: var(--text-primary); font-size: 1.15rem; }
html[lang="tr"] .why-modernize ul { list-style: none; padding: 0; display: grid; gap: 0.75rem; }
html[lang="tr"] .why-modernize li { background: var(--bg-elevated); border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: 8px; padding: 0.9rem 1.1rem; color: var(--text-primary); }
html[lang="tr"] .faq-section { background: var(--bg-subtle); }
html[lang="tr"] .faq-section .section-subtitle { text-align: center; margin-bottom: 2rem; }
html[lang="tr"] .faq-list { display: grid; gap: 1rem; }
html[lang="tr"] .faq-list .faq-item { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem 1.5rem; }
html[lang="tr"] .faq-list .faq-question { font-size: 1.1rem; margin-bottom: 0.5rem; }
html[lang="tr"] .faq-list .faq-answer { color: var(--text-secondary); line-height: 1.7; }
html[lang="tr"] .service-card h3 a { color: inherit; text-decoration: none; }
html[lang="tr"] .service-card a { color: var(--primary-light); text-decoration: none; font-weight: 600; }
html[lang="tr"] .service-card a:hover { text-decoration: underline; }
html[lang="tr"] .why-us-grid { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
html[lang="tr"] .services-detail, html[lang="tr"] .tech-stack-section { padding: 5rem 0; }
html[lang="tr"] .services-detail > .container > h2, html[lang="tr"] .tech-stack-section h2 { font-size: 2.25rem; font-weight: 800; text-align: center; margin-bottom: 0.75rem; }
html[lang="tr"] .services-detail > .container > .section-subtitle, html[lang="tr"] .tech-stack-section .section-subtitle { text-align: center; margin-bottom: 2.5rem; }
html[lang="tr"] .service-detail h3 { font-size: 1.6rem; font-weight: 700; margin: 0.75rem 0; }
html[lang="tr"] .tech-categories { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; }
html[lang="tr"] .tech-category { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem; }
html[lang="tr"] .tech-category h3 { font-size: 1.1rem; margin-bottom: 0.75rem; }
html[lang="tr"] .page-hero .btn-secondary { color: #fff; border-color: rgba(255, 255, 255, 0.7); }
@media (max-width: 768px) {
  html[lang="tr"] .why-modernize h2, html[lang="tr"] .faq-section h2 { font-size: 1.75rem; }
}
</style>
