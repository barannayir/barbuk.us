{%- comment -%}
  Service JSON-LD schema generator.
  Usage: {% include "service-schema.liquid" with services: t.services %}
  LiquidJS 10+ uyumlu: with ile geçirilen parametreler include scope'unda
  doğrudan isimle erişilebilir (`services`), eski `include.services` artık
  undefined döner.
{%- endcomment -%}
{%- if services -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": [
    {%- for s in services -%}
    {
      "@type": "ListItem",
      "position": {{ forloop.index }},
      "item": {
        "@type": "Service",
        "name": {{ s.title | jsonify }},
        "description": {{ s.intro | jsonify }},
        "provider": {
          "@type": "Organization",
          "name": "Barbuk"
        }
      }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
