<header class="header">
  <nav class="nav">
    <div class="container">
      <a href="{{ '/' | localizedUrl: page.lang }}" class="logo">
        <span class="logo-text">Barbuk</span>
      </a>

      <!-- Hamburger Button -->
      <button class="hamburger" id="hamburger" aria-label="{{ i18n.nav.menu_aria | default: 'Menu' }}">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <ul class="nav-menu" id="navMenu">
        <li><a href="{{ '/' | localizedUrl: page.lang }}">{{ i18n.nav.home | default: 'Home' }}</a></li>
        <li><a href="{{ '/portfolio' | localizedUrl: page.lang }}">{{ i18n.nav.portfolio | default: 'Portfolio' }}</a></li>
        <li><a href="{{ '/services' | localizedUrl: page.lang }}">{{ i18n.nav.services | default: 'Services' }}</a></li>
        <li><a href="{{ '/blog' | localizedUrl: page.lang }}">{{ i18n.nav.insights | default: 'Insights' }}</a></li>
        <li><a href="{{ '/about' | localizedUrl: page.lang }}">{{ i18n.nav.about | default: 'About' }}</a></li>
        <li><a href="{{ '/contact' | localizedUrl: page.lang }}" class="btn-primary">{{ i18n.nav.contact | default: 'Contact' }}</a></li>
      </ul>

      <!-- Language Switcher -->
      {%- assign currentLang = page.url | detectLang -%}
      <div class="lang-switcher" id="langSwitcher">
        <button class="lang-current" id="langToggle" aria-label="{{ i18n.meta[currentLang].native }}" title="{{ i18n.meta[currentLang].native }}" aria-haspopup="true" aria-expanded="false">
          <span class="flag" aria-hidden="true">{{ i18n.meta[currentLang].flag }}</span>
          <span class="chev" aria-hidden="true">▾</span>
        </button>
        <ul class="lang-menu" id="langMenu" role="menu">
          {%- for code in i18n.languages -%}
            <li>
              <a href="{{ page.url | urlByLang: code }}" data-lang="{{ code }}" class="lang-option{% if code == currentLang %} is-active{% endif %}" role="menuitem" title="{{ i18n.meta[code].native }}" aria-label="{{ i18n.meta[code].native }}">
                <span class="flag" aria-hidden="true">{{ i18n.meta[code].flag }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </nav>
</header>

<script>
  // Mobile Menu Toggle
  const hamburger = document.getElementById('hamburger');
  const navMenu = document.getElementById('navMenu');

  if (hamburger && navMenu) {
    hamburger.addEventListener('click', () => {
      hamburger.classList.toggle('active');
      navMenu.classList.toggle('active');
    });

    document.querySelectorAll('.nav-menu a').forEach(link => {
      link.addEventListener('click', () => {
        hamburger.classList.remove('active');
        navMenu.classList.remove('active');
      });
    });
  }

  // Language Switcher Toggle
  const langSwitcher = document.getElementById('langSwitcher');
  const langToggle = document.getElementById('langToggle');
  const langMenu = document.getElementById('langMenu');

  if (langSwitcher && langToggle && langMenu) {
    langToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = langSwitcher.classList.toggle('open');
      langToggle.setAttribute('aria-expanded', String(isOpen));
    });

    document.addEventListener('click', (e) => {
      if (!langSwitcher.contains(e.target)) {
        langSwitcher.classList.remove('open');
        langToggle.setAttribute('aria-expanded', 'false');
      }
    });

    // ESC ile kapat
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && langSwitcher.classList.contains('open')) {
        langSwitcher.classList.remove('open');
        langToggle.setAttribute('aria-expanded', 'false');
        langToggle.focus();
      }
    });

    // Dil seçimini localStorage'a kaydet
    document.querySelectorAll('.lang-option').forEach(opt => {
      opt.addEventListener('click', () => {
        const lang = opt.getAttribute('data-lang');
        try { localStorage.setItem('barbuk_lang', lang); } catch (e) {}
      });
    });
  }

  // Accept-Language auto-redirect (sadece kök, sadece ilk ziyaret, sadece İngilizce kök'teyse)
  (function() {
    const path = window.location.pathname;
    const isRoot = path === '/' || path === '/index.html' || path === '';
    const supportedLangs = ['en', 'de', 'fr', 'nl', 'it', 'es'];
    const defaultLang = 'en';

    // Mevcut dil (path'ten tahmin)
    const seg = path.split('/').filter(Boolean)[0];
    const currentLang = supportedLangs.includes(seg) ? seg : defaultLang;

    // localStorage zaten varsa kullanıcı seçmiş demektir — karışma
    let stored = null;
    try { stored = localStorage.getItem('barbuk_lang'); } catch (e) {}
    if (stored) return;

    // Kök'te değilsek zaten bir dildeyiz
    if (!isRoot) return;

    // Accept-Language'dan dil tespit et
    const browserLang = (navigator.language || navigator.userLanguage || defaultLang).toLowerCase().split('-')[0];
    if (!supportedLangs.includes(browserLang)) return;
    if (browserLang === currentLang) return;

    // Redirect: /de/, /fr/ vb. → yönlendir
    window.location.replace('/' + browserLang + '/');
  })();
</script>
