<section class="portfolio-preview">
  <div class="container">
    <h2>{{ t.portfolio_title }}</h2>
    <p class="section-subtitle">{{ t.portfolio_subtitle }}</p>

    <div class="portfolio-slider">
      <div class="portfolio-item">
        <div class="before-after-container">
          <div class="before-after">
            <div class="before">
              <iframe src="/demos/legacy-admin.html" style="width: 100%; height: 100%; border: none; background: white;"></iframe>
            </div>
            <div class="after">
              <iframe src="/demos/modern-admin.html" style="width: 100%; height: 100%; border: none;"></iframe>
            </div>
            <div class="slider-handle" id="slider"></div>
          </div>
          <div class="badge-before">{{ t.before_badge }}</div>
          <div class="badge-after">{{ t.after_badge }}</div>
        </div>
        <h3>{{ t.case_study_title }}</h3>
        <p>{{ t.case_study_desc }}</p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.1);">
          <div>
            <h4 style="color: #10b981; font-size: 1.5rem; margin-bottom: 0.5rem;">60%</h4>
            <p style="color: rgba(255,255,255,0.7);">{{ t.metric_1 }}</p>
          </div>
          <div>
            <h4 style="color: #10b981; font-size: 1.5rem; margin-bottom: 0.5rem;">94%</h4>
            <p style="color: rgba(255,255,255,0.7);">{{ t.metric_2 }}</p>
          </div>
          <div>
            <h4 style="color: #10b981; font-size: 1.5rem; margin-bottom: 0.5rem;">{{ t.metric_3_value }}</h4>
            <p style="color: rgba(255,255,255,0.7);">{{ t.metric_3 }}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="text-center">
      <a href="{{ '/portfolio' | localizedUrl: lang }}" class="btn-primary btn-lg">{{ t.portfolio_cta }}</a>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container">
    <h2>{{ t.cta_title }}</h2>
    <p>{{ t.cta_desc }}</p>
    <a href="{{ '/contact' | localizedUrl: lang }}" class="btn-primary btn-lg">{{ t.cta_button }}</a>
  </div>
</section>

<script>
  // Before/After Slider
  const slider = document.getElementById('slider');
  const afterDiv = document.querySelector('.after');
  const container = document.querySelector('.before-after-container');
  const badgeBefore = document.querySelector('.badge-before');
  const badgeAfter = document.querySelector('.badge-after');

  if (slider && afterDiv && container) {
    let isDragging = false;

    function updateSlider(x) {
      const rect = container.getBoundingClientRect();
      const pos = ((x - rect.left) / rect.width) * 100;
      const clampedPos = Math.max(0, Math.min(100, pos));

      slider.style.left = clampedPos + '%';
      afterDiv.style.clipPath = `inset(0 ${100 - clampedPos}% 0 0)`;

      if (clampedPos < 20) {
        badgeAfter.style.opacity = '0';
      } else {
        badgeAfter.style.opacity = '1';
      }

      if (clampedPos > 80) {
        badgeBefore.style.opacity = '0';
      } else {
        badgeBefore.style.opacity = '1';
      }
    }

    slider.addEventListener('mousedown', () => isDragging = true);
    document.addEventListener('mouseup', () => isDragging = false);

    container.addEventListener('mousemove', (e) => {
      if (isDragging) updateSlider(e.clientX);
    });

    container.addEventListener('click', (e) => {
      updateSlider(e.clientX);
    });

    slider.addEventListener('touchstart', () => isDragging = true);
    document.addEventListener('touchend', () => isDragging = false);

    container.addEventListener('touchmove', (e) => {
      if (isDragging) {
        e.preventDefault();
        updateSlider(e.touches[0].clientX);
      }
    });
  }
</script>
