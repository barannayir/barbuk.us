{%- comment -%}
  TR sayfaları için SSS bölümü + FAQPage JSON-LD.
  Kullanım: {% include "tr-faq.liquid", faq: t.faq %}  (faq = { title, subtitle, items[{question, answer}] })
  Görünüm EN pillar sayfalarındaki faq-section işaretlemesini izler.
{%- endcomment -%}
{%- if faq and faq.items.size > 0 -%}
<section class="faq-section">
  <div class="container">
    <h2>{{ faq.title }}</h2>
    <p class="section-subtitle">{{ faq.subtitle }}</p>

    <div class="faq-list">
      {% for item in faq.items %}
      <div class="faq-item">
        <h3 class="faq-question">{{ item.question }}</h3>
        <p class="faq-answer">{{ item.answer }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": "tr-TR",
  "mainEntity": [
    {%- for item in faq.items -%}
    {
      "@type": "Question",
      "name": {{ item.question | jsonify }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ item.answer | jsonify }}
      }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
