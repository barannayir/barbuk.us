<section class="page-hero">
  <div class="container">
    <h1>{{ t.page_hero.title }}</h1>
    <p class="page-subtitle">{{ t.page_hero.subtitle }}</p>
  </div>
</section>

<section class="contact-section">
  <div class="container">
    <div class="contact-grid">

      <div class="contact-form-container">
        <h2>{{ t.form_section.title }}</h2>
        <p>{{ t.form_section.intro }}</p>

        <form class="contact-form" id="contactForm">
          <div id="formMessage" class="form-message" style="display: none;"></div>

          <div class="form-group">
            <label for="name">{{ t.form_section.fields.name_label }}</label>
            <input type="text" id="name" name="name" required placeholder="{{ t.form_section.fields.name_placeholder }}">
          </div>

          <div class="form-group">
            <label for="email">{{ t.form_section.fields.email_label }}</label>
            <input type="email" id="email" name="email" required placeholder="{{ t.form_section.fields.email_placeholder }}">
          </div>

          <div class="form-group">
            <label for="company">{{ t.form_section.fields.company_label }}</label>
            <input type="text" id="company" name="company" placeholder="{{ t.form_section.fields.company_placeholder }}">
          </div>

          <div class="form-group">
            <label for="project">{{ t.form_section.fields.project_label }}</label>
            <select id="project" name="project" required>
              <option value="">{{ t.form_section.fields.project_placeholder }}</option>
              {% for option in t.form_section.project_options %}
              <option value="{{ option }}">{{ option }}</option>
              {% endfor %}
            </select>
          </div>

          <div class="form-group">
            <label for="message">{{ t.form_section.fields.message_label }}</label>
            <textarea id="message" name="message" rows="6" required placeholder="{{ t.form_section.fields.message_placeholder }}"></textarea>
          </div>

          <button type="submit" class="btn-primary btn-lg" id="submitBtn">
            <span id="btnText">{{ t.form_section.fields.submit_button }}</span>
            <span id="btnLoader" style="display: none;">{{ t.form_section.fields.submitting_button }}</span>
          </button>
        </form>

        <script>
          const errorFallback = {{ t.form_section.error_fallback | jsonify }};
          document.getElementById('contactForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const form = e.target;
            const submitBtn = document.getElementById('submitBtn');
            const btnText = document.getElementById('btnText');
            const btnLoader = document.getElementById('btnLoader');
            const formMessage = document.getElementById('formMessage');

            submitBtn.disabled = true;
            btnText.style.display = 'none';
            btnLoader.style.display = 'inline';
            formMessage.style.display = 'none';

            try {
              const formData = new FormData(form);

              const response = await fetch('https://barbuk-contact-form.barannayir.workers.dev', {
                method: 'POST',
                body: formData
              });

              const result = await response.json();

              if (result.success) {
                if (typeof gtag !== 'undefined') {
                  gtag('event', 'form_submit', {
                    event_category: 'engagement',
                    event_label: 'contact_form',
                    value: 1
                  });
                }

                formMessage.textContent = result.message;
                formMessage.className = 'form-message success';
                formMessage.style.display = 'block';
                form.reset();
              } else {
                throw new Error(result.error || errorFallback);
              }
            } catch (error) {
              formMessage.textContent = error.message || errorFallback;
              formMessage.className = 'form-message error';
              formMessage.style.display = 'block';
            } finally {
              submitBtn.disabled = false;
              btnText.style.display = 'inline';
              btnLoader.style.display = 'none';
            }
          });
        </script>
      </div>

      <div class="contact-info">
        <h2>{{ t.contact_methods.title }}</h2>

        {% for method in t.contact_methods.methods %}
        <div class="contact-method">
          <div class="method-content">
            <h3>{{ method.title }}</h3>
            {% if method.url %}
            <a href="{{ method.url }}" target="_blank">{{ method.link }}</a>
            {% else %}
            <a href="mailto:{{ method.link }}">{{ method.link }}</a>
            {% endif %}
            <p>{{ method.description }}</p>
          </div>
        </div>
        {% endfor %}

        <div class="faq-box">
          <h3>{{ t.faq.title }}</h3>
          {% for item in t.faq.items %}
          <div class="faq-item">
            <strong>Q: {{ item.question }}</strong>
            <p>{{ item.answer }}</p>
          </div>
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</section>

<section class="trust-indicators">
  <div class="container">
    <div class="trust-grid">
      {% for card in t.trust_section.cards %}
      <div class="trust-item">
        <h3>{{ card.title }}</h3>
        <p>{{ card.description }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
